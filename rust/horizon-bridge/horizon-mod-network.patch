@@ -0,0 +1,227 @@
+//! Real WASM client/server components exercising the connection-bound capability.
+use horizon_mods::{
+    Mods, Output, Package, Runs, ServerPlayer, Snapshot, Status, manifest::componentize,
+};
+use std::{
+    path::{Path, PathBuf},
+    process::Command,
+    sync::OnceLock,
+};
+
+fn guests() -> &'static (PathBuf, PathBuf) {
+    static GUESTS: OnceLock<(PathBuf, PathBuf)> = OnceLock::new();
+    GUESTS.get_or_init(|| {
+        let root = Path::new(env!("CARGO_MANIFEST_DIR")).join("../..");
+        let target = root.join("target/mods-net-test");
+        let mut paths = Vec::new();
+        for (side, feature, api, extra) in [
+            ("client", "network", "0.1", ", \"chat\", \"storage\""),
+            ("server", "server-network", "0.3", ", \"players\""),
+        ] {
+            let status = Command::new(env!("CARGO")).current_dir(&root)
+                .args(["build", "--release", "--target", "wasm32-unknown-unknown", "-p", "horizon-mods-test-guest", "--features", feature, "--target-dir"])
+                .arg(&target).status().unwrap();
+            assert!(status.success(), "the WASM test target must be installed");
+            let core = std::fs::read(target.join("wasm32-unknown-unknown/release/horizon_mods_test_guest.wasm")).unwrap();
+            let manifest = format!("id = \"channel_test\"\nname = \"Channel {side}\"\nversion = \"1\"\napi = \"{api}\"\nside = \"{side}\"\ncapabilities = [\"net\"{extra}]\nexperimental = [\"net\"]\n");
+            let path = target.join(format!("{side}.hmod"));
+            std::fs::write(&path, Package::write(&manifest, &componentize(&core).unwrap()).unwrap()).unwrap();
+            paths.push(path);
+        }
+        (paths.remove(0), paths.remove(0))
+    })
+}
+
+fn player(id: &str) -> ServerPlayer {
+    ServerPlayer {
+        id: id.into(),
+        name: "Alex".into(),
+        x: 0.0,
+        y: 64.0,
+        z: 0.0,
+        dimension: "minecraft:overworld".into(),
+        health: 20.0,
+        game_mode: horizon_mods::GameMode::Survival,
+    }
+}
+fn snapshot() -> Snapshot {
+    Snapshot {
+        network_connected: true,
+        players: vec![player("authenticated-player")],
+        ..Default::default()
+    }
+}
+fn feedback(out: &[Output]) -> Option<&str> {
+    out.iter().find_map(|o| {
+        if let Output::Feedback { text, .. } = o {
+            Some(text.as_str())
+        } else {
+            None
+        }
+    })
+}
+fn client() -> Mods {
+    let mut mods = Mods::load_for(Runs::Client, &[guests().0.clone()], |_| true, |_| false);
+    assert_eq!(mods.entries()[0].status, Status::Running);
+    mods.set_snapshot(snapshot());
+    mods
+}
+
+#[test]
+fn real_components_route_by_mod_and_authenticated_sender() {
+    let mut client = client();
+    let mut server = Mods::load_for(Runs::Server, &[guests().1.clone()], |_| true, |_| false);
+    assert_eq!(server.entries()[0].status, Status::Running);
+    server.set_snapshot(snapshot());
+    assert!(!server.receive_network("other_mod", Some("authenticated-player"), b"secret"));
+    assert!(!server.receive_network("channel_test", None, b"wrong side"));
+    assert!(client.command("net_send hello"));
+    let out = client.drain();
+    let (id, data) = out
+        .iter()
+        .find_map(|o| match o {
+            Output::Network {
+                mod_id,
+                player: None,
+                data,
+                ..
+            } => Some((mod_id, data)),
+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(id, "channel_test");
+    assert!(server.receive_network(id, Some("authenticated-player"), data));
+    server.server_tick(1);
+    let out = server.drain();
+    let (id, recipient, data) = out
+        .iter()
+        .find_map(|o| match o {
+            Output::Network {
+                mod_id,
+                player: Some(player),
+                data,
+                ..
+            } => Some((mod_id, player, data)),
+            _ => None,
+        })
+        .unwrap();
+    assert_eq!(recipient, "authenticated-player");
+    assert!(client.receive_network(id, None, data));
+    assert!(client.command("net_poll"));
+    assert_eq!(feedback(&client.drain()), Some("server:hello"));
+}
+
+#[test]
+fn client_cannot_forge_recipients_and_sends_have_hook_budgets() {
+    let mut client = client();
+    assert!(client.command("net_spoof hello"));
+    assert!(
+        !client
+            .drain()
+            .iter()
+            .any(|o| matches!(o, Output::Network { .. }))
+    );
+    client.command("net_burst");
+    let output = client.drain();
+    assert_eq!(feedback(&output), Some("limited"));
+    assert_eq!(
+        output
+            .iter()
+            .filter(|o| matches!(o, Output::Network { .. }))
+            .count(),
+        8
+    );
+    client.command("net_send next hook");
+    assert_eq!(
+        client
+            .drain()
+            .iter()
+            .filter(|o| matches!(o, Output::Network { .. }))
+            .count(),
+        1
+    );
+}
+
+#[test]
+fn reconnect_clears_queued_bytes_and_notifies_the_client() {
+    let mut client = client();
+    assert!(client.receive_network("channel_test", None, b"old-session"));
+    client.command("net_send old outgoing");
+    client.network_disconnected();
+    assert!(
+        !client
+            .drain()
+            .iter()
+            .any(|o| matches!(o, Output::Network { .. }))
+    );
+    client.command("net_poll");
+    assert_eq!(feedback(&client.drain()), Some("disconnected"));
+    client.command("net_send disconnected");
+    assert!(
+        !client
+            .drain()
+            .iter()
+            .any(|o| matches!(o, Output::Network { .. }))
+    );
+    client.set_snapshot(snapshot());
+    assert!(client.receive_network("channel_test", None, b"new-session"));
+    client.command("net_poll");
+    assert_eq!(feedback(&client.drain()), Some("server:new-session"));
+}
+
+#[test]
+fn trapping_hooks_cannot_send_partial_network_results() {
+    let mut client = client();
+    client.command("net_panic");
+    assert!(matches!(client.entries()[0].status, Status::Failed(_)));
+    assert!(
+        !client
+            .drain()
+            .iter()
+            .any(|o| matches!(o, Output::Network { .. }))
+    );
+}
+
+#[test]
+fn in_frame_can_load_both_halves_with_the_same_mod_id() {
+    let mut mods = Mods::load_for(
+        Runs::Both,
+        &[guests().0.clone(), guests().1.clone()],
+        |_| true,
+        |_| false,
+    );
+    assert!(mods.entries().iter().all(|e| e.status == Status::Running));
+    mods.set_snapshot(snapshot());
+    assert!(mods.receive_network("channel_test", Some("authenticated-player"), b"loopback"));
+    mods.server_tick(1);
+    let outputs = mods.drain();
+    for output in outputs {
+        if let Output::Network {
+            mod_id,
+            player: Some(_),
+            data,
+            ..
+        } = output
+        {
+            assert!(mods.receive_network(&mod_id, None, &data));
+        }
+    }
+    mods.command("net_poll");
+    assert_eq!(feedback(&mods.drain()), Some("server:loopback"));
+}
+
+#[test]
+fn offline_players_cannot_receive_or_replay_queued_messages() {
+    let mut server = Mods::load_for(Runs::Server, &[guests().1.clone()], |_| true, |_| false);
+    server.set_snapshot(snapshot());
+    assert!(server.receive_network("channel_test", Some("authenticated-player"), b"old"));
+    server.player_left(&player("authenticated-player"));
+    server.set_snapshot(Snapshot::default());
+    server.server_tick(1);
+    assert!(
+        !server
+            .drain()
+            .iter()
+            .any(|o| matches!(o, Output::Network { .. }))
+    );
+}
