+//! Generic mod gameplay adapter. All mutations execute on the authoritative
+//! game thread, against the selected stack, with no client supplied aim/pose.
+#[cfg(feature = "mods")]
+use super::{Game, boats::Boat, lan::LanHost};
+#[cfg(feature = "mods")]
+use horizon_client::{
+    items::ItemStack,
+    mod_vehicle::{self, ModVehicle, VehicleProfile},
+};
+#[cfg(feature = "mods")]
+use horizon_core::geometry::Vec3;
+#[cfg(feature = "mods")]
+impl Game<'_> {
+    pub(super) fn mod_inventories(&self) -> Vec<(String, horizon_mods::PlayerInventory)> {
+        let mut result = Vec::new();
+        for owner in self.mods.mods.gameplay_ids() {
+            let stacks = |items: &[Option<ItemStack>], selected: usize| {
+                items
+                    .iter()
+                    .enumerate()
+                    .filter_map(|(slot, s)| {
+                        s.as_ref().map(|s| horizon_mods::InventoryStack {
+                            slot: slot as u32,
+                            item: s.item.to_string(),
+                            count: s.count,
+                            selected: slot == selected,
+                            state: mod_vehicle::item_state(s, &owner),
+                        })
+                    })
+                    .collect()
+            };
+            if self.remote.is_none()
+                && self.options.execution_role.is_client()
+                && self.player.is_some()
+            {
+                result.push((
+                    owner.clone(),
+                    horizon_mods::PlayerInventory {
+                        player: self.player_uuid_string(),
+                        stacks: stacks(&self.inventory, self.selected),
+                    },
+                ));
+            }
+            if let Some(host) = &self.lan {
+                for g in host.hub.guests.iter().filter(|g| g.placed) {
+                    result.push((
+                        owner.clone(),
+                        horizon_mods::PlayerInventory {
+                            player: super::mod_network::uuid_string(g.uuid),
+                            stacks: stacks(&g.inventory, g.selected),
+                        },
+                    ));
+                }
+            }
+        }
+        result
+    }
+    pub(super) fn mod_vehicles(&self) -> Vec<(String, horizon_mods::ModVehicle)> {
+        self.boats
+            .iter()
+            .map(|boat| (self.dim, boat))
+            .chain(
+                self.levels
+                    .parked_boats()
+                    .filter(|(dim, _)| *dim != self.dim),
+            )
+            .filter_map(|(dim, b)| {
+                let v = b.mod_vehicle.as_ref()?;
+                Some((
+                    v.owner.clone(),
+                    horizon_mods::ModVehicle {
+                        entity: b.id,
+                        definition: v.profile.definition.clone(),
+                        dimension: dim.id().into(),
+                        profile: serde_json::to_string(&v.profile).ok()?,
+                        x: b.position.x,
+                        y: b.position.y,
+                        z: b.position.z,
+                        yaw: b.yaw,
+                        vx: b.velocity.x,
+                        vy: b.velocity.y,
+                        vz: b.velocity.z,
+                    },
+                ))
+            })
+            .collect()
+    }
+    pub(super) fn apply_mod_inventory(
+        &mut self,
+        host: Option<&mut LanHost>,
+        owner: &str,
+        edit: horizon_mods::InventoryEdit,
+    ) {
+        if self.remote.is_some() {
+            return;
+        }
+        if self.options.execution_role.is_client()
+            && self.player.is_some()
+            && self.player_uuid_string() == edit.player
+        {
+            self.commit_mod_inventory(owner, edit);
+            return;
+        }
+        let own_host = host.is_none();
+        let mut taken = if own_host { self.lan.take() } else { None };
+        if let Some(host) = host.or(taken.as_mut()) {
+            let target = host
+                .hub
+                .guests
+                .iter()
+                .find(|g| {
+                    g.placed
+                        && g.loaded
+                        && !g.dead
+                        && super::mod_network::uuid_string(g.uuid) == edit.player
+                })
+                .map(|g| (g.conn, super::Dim::from_id(&g.dimension)));
+            if let Some((conn, theirs)) = target
+                && !self.on_server_trip(conn)
+            {
+                // as_guest lends only the player's state. The world and
+                // entities must first be those of that player's dimension.
+                let back = self.dim;
+                let entered = if theirs == back {
+                    true
+                } else {
+                    match self.enter_level(Some(host), theirs) {
+                        Ok(()) => self.dim == theirs,
+                        Err(error) => {
+                            log::error!("could not open {} for mod gameplay: {error}", theirs.id());
+                            false
+                        }
+                    }
+                };
+                if entered {
+                    self.as_guest(host, conn, |game| game.commit_mod_inventory(owner, edit));
+                }
+                if self.dim != back
+                    && let Err(error) = self.enter_level(Some(host), back)
+                {
+                    log::error!("could not reopen {} after mod gameplay: {error}", back.id());
+                }
+            }
+        }
+        if own_host {
+            self.lan = taken;
+        }
+    }
+    fn commit_mod_inventory(&mut self, owner: &str, edit: horizon_mods::InventoryEdit) {
+        if self.selected != edit.slot as usize
+            || self.spectator()
+            || self.player.as_ref().is_none_or(|p| p.health.health() <= 0.)
+        {
+            return;
+        }
+        let Some(held) = self.held() else {
+            return;
+        };
+        if held.item.as_ref() != edit.item
+            || held.count != 1
+            || mod_vehicle::item_state(held, owner) != edit.expected
+        {
+            return;
+        }
+        let available: u32 = self
+            .inventory
+            .iter()
+            .flatten()
+            .filter(|s| s.item.as_ref() == edit.ammo)
+            .map(|s| s.count)
+            .sum();
+        if (edit.consume > 0 && edit.ammo == edit.item) || available < edit.consume {
+            return;
+        }
+        let Some(eye) = self.eye_position() else {
+            return;
+        };
+        let spawn = if let Some(json) = &edit.vehicle {
+            let Some(profile) = VehicleProfile::parse(json, owner).filter(|p| p.item == edit.item)
+            else {
+                return;
+            };
+            // The native placement ray stops at blocks. A failed placement
+            // leaves both the item and all its data untouched.
+            let Some(hit) = self.pick() else {
+                return;
+            };
+            let at = Vec3::new(hit.point[0], hit.point[1] + 0.02, hit.point[2]);
+            let mut b = Boat::new(self.next_entity + 1, "oak".into(), at, self.yaw);
+            b.mod_vehicle = Some(ModVehicle {
+                owner: owner.into(),
+                health: profile.max_health,
+                profile,
+            });
+            let mut scene = horizon_client::collisions::SceneCollisions {
+                world: &self.world,
+                binding: self.collision,
+                subject: None,
+            };
+            if self.boat_entity_collision(b.bounds()) {
+                return;
+            }
+            if !scene
+                .unobstructed(b.bounds().deflate(Vec3::new(1e-5, 1e-5, 1e-5)))
+                .unwrap_or(false)
+            {
+                return;
+            }
+            Some(b)
+        } else {
+            None
+        };
+        if !mod_vehicle::apply_inventory_edit(&mut self.inventory, self.selected, owner, &edit) {
+            return;
+        }
+        if let Some(b) = spawn {
+            self.next_entity += 1;
+            self.world.modified.insert((
+                b.position.x.floor() as i32 >> 4,
+                b.position.z.floor() as i32 >> 4,
+            ));
+            self.boats.push(b);
+        }
+        if let Some(spec) = edit.shot {
+            use horizon_client::{
+                mobs::Who as Owner,
+                projectiles::{Projectile, ProjectileKind},
+            };
+            let kind = ProjectileKind::Arrow {
+                base_damage: f64::from(spec.damage / spec.speed),
+                critical: false,
+                effect: None,
+            };
+            let mut p = Projectile::new(
+                kind,
+                Vec3::new(eye[0], eye[1] - 0.1, eye[2]),
+                Some(Owner::Player),
+            );
+            if let Some(a) = p.arrow.as_mut() {
+                a.set_owner(Some(Owner::Player));
+                a.set_item(&horizon_client::arrows::drawn_ammo(
+                    &ItemStack::new("minecraft:arrow", 1),
+                    true,
+                ));
+            }
+            p.shoot_from_rotation(
+                &mut self.world.random,
+                self.pitch,
+                self.yaw,
+                0.,
+                spec.speed,
+                spec.inaccuracy,
+                Vec3::ZERO,
+                true,
+            );
+            self.add_projectile(p);
+            self.player_projectile_shot();
+            self.audio.play(
+                "minecraft:entity.firework_rocket.blast",
+                Some(eye),
+                0.7,
+                1.6,
+            );
+        }
+    }
+    pub(super) fn apply_vehicle_models(&mut self, owner: &str, models: Vec<(u32, String)>) {
+        if self.remote.is_none() {
+            return;
+        } // A client never overrides authoritative profiles.
+        for b in &mut self.boats {
+            if let Some((_, json)) = models.iter().find(|(id, _)| *id == b.id) {
+                if let Some(profile) = VehicleProfile::parse(json, owner) {
+                    b.mod_vehicle = Some(ModVehicle {
+                        owner: owner.into(),
+                        health: profile.max_health,
+                        profile,
+                    });
+                }
+            } else if b.mod_vehicle.as_ref().is_some_and(|v| v.owner == owner) {
+                b.mod_vehicle = None;
+            }
+        }
+    }
+}
