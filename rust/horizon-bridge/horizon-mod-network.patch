+        let mut inventory = vec![
+            Some(ItemStack::new("test:gun", 1)),
+            Some(ItemStack::new("test:ammo", 2)),
+        ];
+        let mut edit = horizon_mods::InventoryEdit {
+            player: "p".into(),
+            slot: 0,
+            item: "test:gun".into(),
+            expected: vec![],
+            state: vec![1],
