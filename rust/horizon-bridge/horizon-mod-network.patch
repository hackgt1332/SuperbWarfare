+    pub(super) fn receive_mod_network(&mut self, data: &[u8]) {
+        if self
+            .remote
+            .as_ref()
+            .is_none_or(|remote| !remote.mod_channel)
+        {
+            return;
+        }
+        if let Ok(message) = horizon_protocol::mod_channel::decode(data) {
+            self.mods
+                .mods
+                .receive_network(&message.mod_id, None, &message.data);
+        }
+    }
+    pub(super) fn guest_mod_network(&mut self, host: &mut LanHost, conn: u32, data: &[u8]) {
+        let Some(guest) = host.hub.guest(conn) else {
+            return;
+        };
+        let Ok(message) = horizon_protocol::mod_channel::decode(data) else {
+            return;
+        };
+        // Identity comes solely from the server's authenticated Guest.
+        let player = uuid_string(guest.uuid);
+        self.mods.mods.receive_network_from(
+            &message.mod_id,
+            &player,
+            &message.data,
+            u64::from(conn),
+        );
+    }
+    pub(super) fn send_mod_network(
+        &mut self,
+        host: Option<&mut LanHost>,
+        mod_id: String,
+        player: Option<String>,
+        connection: Option<u64>,
+        data: Vec<u8>,
+    ) {
+        use horizon_protocol::{
+            mod_channel,
+            packets::{configuration::CustomPayload, play},
+        };
+        let Ok(encoded) = mod_channel::encode(&mod_id, &data) else {
+            return;
+        };
+        match player {
+            None if self
+                .remote
+                .as_ref()
+                .is_some_and(|remote| remote.mod_channel) =>
+            {
+                self.send(play::Serverbound::CustomPayload(CustomPayload {
+                    channel: mod_channel::CHANNEL.into(),
+                    data: encoded,
+                }));
+            }
+            None if self.remote.is_none() && self.mods.server => {
+                let player = self.player_uuid_string();
+                self.mods
+                    .mods
+                    .receive_network(&mod_id, Some(&player), &data);
+            }
+            Some(player) => {
+                if self.options.execution_role.is_client()
+                    && self.remote.is_none()
+                    && self.player_uuid_string() == player
+                {
+                    self.mods.mods.receive_network(&mod_id, None, &data);
+                } else if let Some(host) = host.as_deref().or(self.lan.as_ref())
+                    && let Some(guest) = host.hub.guests.iter().find(|g| {
+                        uuid_string(g.uuid) == player && connection == Some(u64::from(g.conn))
+                    })
+                {
+                    guest.send(&play::Clientbound::CustomPayload(CustomPayload {
+                        channel: mod_channel::CHANNEL.into(),
+                        data: encoded,
+                    }));
+                }
+            }
+            _ => {}
+        }
+    }
+}
+
+#[cfg(feature = "mods")]
+pub(super) fn uuid_string(uuid: u128) -> String {
+    let value = format!("{uuid:032x}");
+    format!(
+        "{}-{}-{}-{}-{}",
+        &value[..8],
+        &value[8..12],
+        &value[12..16],
+        &value[16..20],
+        &value[20..]
+    )
+}
