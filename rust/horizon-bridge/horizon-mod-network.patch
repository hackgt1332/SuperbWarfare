@@ -0,0 +1,264 @@
+//! Generic data-only ground vehicle profile. Mods supply their own tuning and
+//! cuboids; the engine supplies native passengers, persistence and collisions.
+use serde::{Deserialize, Serialize};
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct VehicleProfile {
+    pub definition: String,
+    pub item: String,
+    pub width: f64,
+    pub length: f64,
+    pub height: f64,
+    pub seat_height: f64,
+    #[serde(default)]
+    pub seat_z: f64,
+    pub acceleration: f64,
+    pub drag: f64,
+    pub max_speed: f64,
+    pub turn_speed: f32,
+    pub max_health: f32,
+    pub boxes: Vec<ModelBox>,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+#[serde(deny_unknown_fields)]
+pub struct ModelBox {
+    pub min: [f32; 3],
+    pub max: [f32; 3],
+    /// RGBA, little endian (red in the low byte).
+    pub color: u32,
+}
+#[derive(Clone, Debug, Serialize, Deserialize)]
+pub struct ModVehicle {
+    pub owner: String,
+    pub profile: VehicleProfile,
+    pub health: f32,
+}
+impl VehicleProfile {
+    pub fn parse(json: &str, owner: &str) -> Option<Self> {
+        if json.len() > 16384 {
+            return None;
+        }
+        let p: Self = serde_json::from_str(json).ok()?;
+        let owned = |s: &str| s.starts_with(&format!("{owner}:")) && s.len() <= 128;
+        let range = |v: f64, a, b| v.is_finite() && (a..=b).contains(&v);
+        (owned(&p.definition)
+            && owned(&p.item)
+            && range(p.width, 0.5, 6.)
+            && range(p.length, 0.5, 8.)
+            && range(p.height, 0.3, 5.)
+            && range(p.seat_height, 0., p.height)
+            && range(p.seat_z, -p.length / 2., p.length / 2.)
+            && range(p.acceleration, 0.001, 0.2)
+            && range(p.drag, 0.5, 0.999)
+            && range(p.max_speed, 0.01, 2.)
+            && range(p.turn_speed.into(), 0.1, 10.)
+            && range(p.max_health.into(), 1., 10000.)
+            && !p.boxes.is_empty()
+            && p.boxes.len() <= 64
+            && p.boxes.iter().all(|b| {
+                (0..3).all(|i| {
+                    range(b.min[i].into(), -8., 8.)
+                        && range(b.max[i].into(), -8., 8.)
+                        && b.min[i] < b.max[i]
+                })
+            }))
+        .then_some(p)
+    }
+}
+/// Mod state sits under the vanilla custom_data component so it follows a
+/// stack through saves, containers, death drops and native inventory packets.
+pub fn item_state(stack: &crate::items::ItemStack, owner: &str) -> Vec<u8> {
+    stack
+        .data()
+        .and_then(|d| d.other("minecraft:custom_data"))
+        .and_then(|t| t.get("horizon_mod_state"))
+        .and_then(|t| t.get(owner))
+        .and_then(|t| {
+            if let horizon_world::nbt::Tag::ByteArray(b) = t {
+                Some(b.clone())
+            } else {
+                None
+            }
+        })
+        .unwrap_or_default()
+}
+pub fn set_item_state(stack: &mut crate::items::ItemStack, owner: &str, bytes: Vec<u8>) {
+    use horizon_world::nbt::{JavaString, Tag};
+    fn put(tag: &mut Tag, key: &str, val: Tag) {
+        if let Tag::Compound(entries) = tag {
+            entries.insert(JavaString::from(key), val);
+        }
+    }
+    let mut data = stack
+        .data()
+        .and_then(|d| d.other("minecraft:custom_data"))
+        .cloned()
+        .filter(|t| matches!(t, Tag::Compound(_)))
+        .unwrap_or_else(|| Tag::Compound(Default::default()));
+    let mut states = data
+        .get("horizon_mod_state")
+        .cloned()
+        .filter(|t| matches!(t, Tag::Compound(_)))
+        .unwrap_or_else(|| Tag::Compound(Default::default()));
+    put(&mut states, owner, Tag::ByteArray(bytes));
+    put(&mut data, "horizon_mod_state", states);
+    stack
+        .data_mut()
+        .set_other("minecraft:custom_data", Some(data));
+}
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn item_state_survives_saved_components_and_preserves_other_mods() {
+        let mut stack = crate::items::ItemStack::new("test:gun", 1);
+        set_item_state(&mut stack, "first", vec![0, 1, 255]);
+        set_item_state(&mut stack, "second", vec![7]);
+        let tag = crate::item_data::encode_components(&stack);
+        let mut restored = crate::items::ItemStack::new("test:gun", 1);
+        let (damage, extra) = crate::item_data::decode_components(tag.as_ref());
+        restored.damage = damage;
+        restored.extra = extra;
+        assert_eq!(item_state(&restored, "first"), vec![0, 1, 255]);
+        assert_eq!(item_state(&restored, "second"), vec![7]);
+    }
+}
+
+/// Native inventory compare/exchange used by the game adapter. Preflight all
+/// conditions before changing any slot; callers spawn effects only on true.
+#[cfg(feature = "mods")]
+pub fn apply_inventory_edit(
+    inventory: &mut [Option<crate::items::ItemStack>],
+    selected: usize,
+    owner: &str,
+    edit: &horizon_mods::InventoryEdit,
+) -> bool {
+    let Some(held) = inventory.get(selected).and_then(|s| s.as_ref()) else {
+        return false;
+    };
+    if selected != edit.slot as usize
+        || held.item.as_ref() != edit.item
+        || held.count != 1
+        || item_state(held, owner) != edit.expected
+        || (edit.consume > 0 && edit.ammo == edit.item)
+    {
+        return false;
+    }
+    let available: u64 = inventory
+        .iter()
+        .flatten()
+        .filter(|s| s.item.as_ref() == edit.ammo)
+        .map(|s| u64::from(s.count))
+        .sum();
+    if available < u64::from(edit.consume) {
+        return false;
+    }
+    let mut left = edit.consume;
+    for (slot, cell) in inventory.iter_mut().enumerate() {
+        if slot == selected {
+            continue;
+        }
+        if let Some(s) = cell.as_mut().filter(|s| s.item.as_ref() == edit.ammo) {
+            let n = left.min(s.count);
+            s.count -= n;
+            left -= n;
+            if s.count == 0 {
+                *cell = None;
+            }
+        }
+    }
+    if edit.vehicle.is_some() {
+        inventory[selected] = None;
+    } else if let Some(s) = inventory[selected].as_mut() {
+        set_item_state(s, owner, edit.state.clone());
+    }
+    true
+}
+#[cfg(all(test, feature = "mods"))]
+mod inventory_tests {
+    use super::*;
+    #[test]
+    fn stale_edits_and_insufficient_ammo_leave_every_slot_untouched() {
+        use crate::items::ItemStack;
+        let mut inventory = vec![
+            Some(ItemStack::new("test:gun", 1)),
+            Some(ItemStack::new("test:ammo", 2)),
+        ];
+        let mut edit = horizon_mods::InventoryEdit {
+            player: "p".into(),
+            slot: 0,
+            item: "test:gun".into(),
+            expected: vec![],
+            state: vec![1],
+            ammo: "test:ammo".into(),
+            consume: 3,
+            shot: None,
+            vehicle: None,
+        };
+        let original = inventory.clone();
+        assert!(!apply_inventory_edit(&mut inventory, 0, "test", &edit));
+        assert_eq!(inventory, original);
+        edit.consume = 2;
+        assert!(apply_inventory_edit(&mut inventory, 0, "test", &edit));
+        assert_eq!(item_state(inventory[0].as_ref().unwrap(), "test"), vec![1]);
+        assert!(inventory[1].is_none());
+        let after = inventory.clone();
+        edit.consume = 0;
+        assert!(!apply_inventory_edit(&mut inventory, 0, "test", &edit));
+        assert_eq!(inventory, after);
+        edit.expected = vec![1];
+        assert!(!apply_inventory_edit(&mut inventory, 1, "test", &edit));
+        assert_eq!(inventory, after);
+    }
+}
+
+#[cfg(test)]
+mod profile_tests {
