diff --git a/crates/horizon-protocol/src/mod_channel.rs b/crates/horizon-protocol/src/mod_channel.rs
new file mode 100644
index 000000000..10c9ee799
--- /dev/null
+++ b/crates/horizon-protocol/src/mod_channel.rs
@@ -0,0 +1,84 @@
+//! Opt-in Horizon mod traffic inside vanilla's custom-payload packet.
+//! The authenticated connection supplies the player; the envelope names only
+//! the destination mod. This protocol never carries a claimed sender identity.
+use crate::{
+    Error, Result,
+    buf::{Reader, Writer},
+};
+
+pub const CHANNEL: &str = "horizon:mod";
+pub const MAX_DATA: usize = 16 * 1024;
+const VERSION: u8 = 1;
+const MAX_ID: usize = 64;
+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub struct Message {
+    pub mod_id: String,
+    pub data: Vec<u8>,
+}
+
+fn valid_id(id: &str) -> bool {
+    !id.is_empty()
+        && id.len() <= MAX_ID
+        && id
+            .bytes()
+            .all(|c| c.is_ascii_lowercase() || c.is_ascii_digit() || c == b'_')
+}
+
+pub fn encode(mod_id: &str, data: &[u8]) -> Result<Vec<u8>> {
+    if !valid_id(mod_id) || data.len() > MAX_DATA {
+        return Err(Error::new("mod channel: invalid id or oversized data"));
+    }
+    let mut writer = Writer::new();
+    writer.u8(VERSION);
+    writer.string(mod_id);
+    writer.data.extend_from_slice(data);
+    Ok(writer.data)
+}
+
+pub fn decode(data: &[u8]) -> Result<Message> {
+    if data.len() > MAX_DATA + MAX_ID + 2 {
+        return Err(Error::new("mod channel: oversized payload"));
+    }
+    let mut reader = Reader::new(data);
+    if reader.u8()? != VERSION {
+        return Err(Error::new("mod channel: unsupported version"));
+    }
+    let mod_id = reader.string(MAX_ID)?;
+    if !valid_id(&mod_id) || reader.remaining() > MAX_DATA {
+        return Err(Error::new("mod channel: invalid id or oversized data"));
+    }
+    // The remainder is one opaque payload, so no attacker-controlled allocation count.
+    let offset = data.len() - reader.remaining();
+    Ok(Message {
+        mod_id,
+        data: data[offset..].to_vec(),
+    })
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn boundary_payload_round_trips_without_a_sender_field() {
+        let bytes = vec![42; MAX_DATA];
+        assert_eq!(
+            decode(&encode("superbwarfare", &bytes).unwrap()).unwrap(),
+            Message {
+                mod_id: "superbwarfare".into(),
+                data: bytes
+            }
+        );
+    }
+    #[test]
+    fn malformed_ids_versions_and_sizes_are_rejected() {
+        for id in ["", "a:b", "../x", "Upper", &"a".repeat(65)] {
+            assert!(encode(id, &[]).is_err());
+        }
+        assert!(encode("a", &vec![0; MAX_DATA + 1]).is_err());
+        assert!(decode(&[]).is_err());
+        assert!(decode(&[2, 1, b'a']).is_err());
+        assert!(decode(&[1, 64, b'a']).is_err());
+        assert!(decode(&vec![0; MAX_DATA + MAX_ID + 3]).is_err());
+    }
+}
