+//! Static textured model assets for mod ground chassis. Geometry stays in the
+//! resource pack; only the definition id travels with a native vehicle.
+use crate::mobs::Part;
+use serde_json::Value;
+use std::{collections::HashMap, path::Path};
+
+pub struct VehicleModel {
+    pub part: Part,
+    pub texture: String,
+    pub wheel_parts: Vec<String>,
+    pub steer_parts: Vec<String>,
+    pub wheel_radius: f32,
+    pub length: f32,
+}
+#[derive(Default)]
+pub struct VehicleModels {
+    models: HashMap<String, VehicleModel>,
+}
+impl VehicleModels {
+    pub fn get(&self, definition: &str) -> Option<&VehicleModel> {
+        self.models.get(definition)
+    }
+    /// `assets/<namespace>/models/entity/<path>.json`, a native Part document
+    /// with a texture resource id. Invalid or oversized documents draw fallback.
+    pub fn load(root: &Path) -> Self {
+        let mut result = Self::default();
+        let Ok(namespaces) = std::fs::read_dir(root.join("assets")) else {
+            return result;
+        };
+        for namespace in namespaces.flatten() {
+            let name = namespace.file_name().to_string_lossy().into_owned();
+            if name == "minecraft" || !id_part(&name, false) {
+                continue;
+            }
+            let base = namespace.path().join("models/entity");
+            result.walk(&name, &base, &base, 0);
+        }
+        result
+    }
+    fn walk(&mut self, namespace: &str, base: &Path, dir: &Path, depth: usize) {
+        if depth > 8 || self.models.len() >= 256 {
+            return;
+        }
+        let Ok(files) = std::fs::read_dir(dir) else {
+            return;
+        };
+        for file in files.flatten() {
+            let Ok(kind) = file.file_type() else {
+                continue;
+            };
+            let path = file.path();
+            if kind.is_dir() {
+                self.walk(namespace, base, &path, depth + 1);
+            } else if kind.is_file() && path.extension().is_some_and(|s| s == "json") {
+                let Ok(meta) = file.metadata() else {
+                    continue;
+                };
+                if meta.len() > 8 * 1024 * 1024 {
+                    continue;
+                }
+                let Ok(relative) = path.strip_prefix(base) else {
+                    continue;
+                };
+                let key = relative
+                    .with_extension("")
+                    .to_string_lossy()
+                    .replace('\\', "/");
+                if !id_part(&key, true) {
+                    continue;
+                }
+                let Ok(bytes) = std::fs::read(&path) else {
+                    continue;
+                };
+                if let Some(model) = parse(&bytes, namespace) {
+                    self.models.insert(format!("{namespace}:{key}"), model);
+                }
+            }
+        }
+    }
+}
+fn id_part(s: &str, slash: bool) -> bool {
+    !s.is_empty()
+        && s.len() <= 128
+        && !s.split('/').any(|p| p.is_empty() || p == "." || p == "..")
+        && s.bytes().all(|b| {
+            b.is_ascii_lowercase()
+                || b.is_ascii_digit()
+                || b == b'_'
+                || b == b'-'
+                || b == b'.'
+                || slash && b == b'/'
+        })
+}
+fn parse(bytes: &[u8], owner: &str) -> Option<VehicleModel> {
+    let value: Value = serde_json::from_slice(bytes).ok()?;
+    let texture = value.get("texture")?.as_str()?;
+    let (namespace, path) = texture.split_once(':')?;
+    if namespace != owner || !id_part(path, true) {
+        return None;
+    }
+    let node = value.get("model")?;
+    let mut budget = 20_000;
+    if !valid_node(node, 0, &mut budget) {
+        return None;
+    }
+    let part = Part::parse("vehicle", node);
+    // Empty geometry would draw nothing at all, leaving a vehicle invisible
+    // with no fallback box behind it: reject so the fallback runs.
+    if part.polygons.is_empty() && !has_geometry(&part) {
+        return None;
+    }
+    let names = |key: &str| -> Option<Vec<String>> {
+        match value.get(key) {
+            None => Some(vec![]),
+            Some(v) => {
+                let a = v.as_array()?;
+                if a.len() > 16 {
+                    return None;
+                }
+                a.iter()
+                    .map(|v| v.as_str().filter(|s| s.len() <= 128).map(String::from))
+                    .collect()
+            }
+        }
+    };
+    // A part reference that names no bone in the tree is a broken document;
+    // keeping it would silently animate nothing (or the wrong bone).
+    let wheel_parts = names("wheel_parts")?;
+    let steer_parts = names("steer_parts")?;
+    let mut tree = HashMap::new();
+    collect_names(&part, &mut tree);
+    if !wheel_parts
+        .iter()
+        .chain(&steer_parts)
+        .all(|n| tree.contains_key(n))
+    {
+        return None;
+    }
+    let length = value
+        .get("bounds")
+        .and_then(|v| v.get(2))
+        .and_then(Value::as_f64)
+        .unwrap_or(1.);
+    if !length.is_finite() || !(0.1..=16.).contains(&length) {
+        return None;
+    }
+    let radius = value
+        .get("wheel_radius")
+        .and_then(Value::as_f64)
+        .unwrap_or(0.35);
+    if !radius.is_finite() || !(0.05..=2.).contains(&radius) {
+        return None;
+    }
+    Some(VehicleModel {
+        part,
+        texture: texture.into(),
+        wheel_parts,
+        steer_parts,
+        wheel_radius: radius as f32,
+        length: length as f32,
+    })
+}
+/// Whether the tree holds any polygon at all (a root with no polygons of its
+/// own still draws when a descendant has some).
+fn has_geometry(part: &Part) -> bool {
+    !part.polygons.is_empty() || part.children.iter().any(has_geometry)
+}
+/// Every part name in the tree; a duplicated name still counts as present.
+fn collect_names(part: &Part, out: &mut HashMap<String, ()>) {
+    out.insert(part.name.clone(), ());
+    for child in &part.children {
+        collect_names(child, out);
+    }
+}
+fn numbers(value: &Value, len: usize, bound: f64) -> bool {
+    value.as_array().is_some_and(|a| {
+        a.len() == len
+            && a.iter().all(|n| {
+                n.as_f64()
+                    .is_some_and(|n| n.is_finite() && n.abs() <= bound)
+            })
+    })
+}
+fn valid_node(value: &Value, depth: usize, budget: &mut usize) -> bool {
+    if depth > 64 || *budget == 0 || !value.is_object() {
+        return false;
+    }
+    *budget -= 1;
+    if value.get("normals").is_some() && value.get("polygons").is_none() {
+        return false;
+    }
+    if let Some(pose) = value.get("pose") {
+        if !numbers(pose, 9, 4096.) {
+            return false;
+        }
+        if pose
+            .as_array()
+            .is_some_and(|a| a[6..].iter().any(|n| n.as_f64().unwrap_or(0.).abs() < 1e-6))
+        {
+            return false;
+        }
+    }
+    if let Some(polys) = value.get("polygons") {
+        let Some(polys) = polys.as_array() else {
+            return false;
+        };
+        if polys.len() > *budget {
+            return false;
+        }
+        *budget -= polys.len();
+        if !polys.iter().all(|p| {
+            p.as_array()
+                .is_some_and(|v| v.len() == 4 && v.iter().all(|v| numbers(v, 5, 4096.)))
+        }) {
+            return false;
+        }
+        if let Some(normals) = value.get("normals")
+            && !normals
+                .as_array()
+                .is_some_and(|n| n.len() == polys.len() && n.iter().all(|v| numbers(v, 3, 1.001)))
+        {
+            return false;
+        }
+    }
+    if let Some(children) = value.get("children") {
+        let Some(children) = children.as_object() else {
+            return false;
+        };
+        if !children
+            .iter()
+            .all(|(name, node)| name.len() <= 128 && valid_node(node, depth + 1, budget))
+        {
+            return false;
+        }
+    }
+    true
+}
