+#[cfg(test)]
+mod mod_vehicle_visual_tests {
+    use super::*;
+
+    fn part(name: &str, polygons: usize, children: Vec<Part>) -> Part {
+        Part {
+            name: name.into(),
+            pose: [0.0; 9],
+            polygons: vec![
+                horizon_client::mobs::Polygon {
+                    normal: [0.0, 0.0, 1.0],
+                    vertices: [[0.0; 5]; 4],
+                };
+                polygons
+            ],
+            children,
+        }
+    }
+
+    /// A model that draws nothing must not take the textured path: the
+    /// fallback box is what keeps the vehicle visible.
+    #[test]
+    fn empty_geometry_falls_through_to_the_fallback() {
+        assert!(!Game::model_has_geometry(&part("vehicle", 0, vec![])));
+        assert!(!Game::model_has_geometry(&part(
+            "vehicle",
+            0,
+            vec![part("wheel", 0, vec![part("rim", 0, vec![])])]
+        )));
+    }
+
+    #[test]
+    fn geometry_on_any_part_counts() {
+        assert!(Game::model_has_geometry(&part("vehicle", 1, vec![])));
+        assert!(Game::model_has_geometry(&part(
+            "vehicle",
+            0,
+            vec![part("wheel", 1, vec![])]
+        )));
+    }
+
+    /// `Poses::has` is the check the renderer uses to skip unknown part
+    /// names; the loader already guarantees they exist, this pins the
+    /// contract that a wheel/steer name must be a real bone.
+    #[test]
+    fn wheel_and_steer_names_resolve_to_bones() {
+        let root = part("vehicle", 0, vec![part("wheel_front", 1, vec![])]);
+        let poses = horizon_client::mobs::anim::Poses::new(&root);
+        assert!(poses.has("wheel_front"));
+        assert!(poses.has("vehicle"));
+        assert!(!poses.has("wheel_rear"));
+    }
+
+    /// The pose slot order the wheel/steer animation targets: 3 is the X roll
+    /// (wheels), 4 the Y yaw (steering), 5 the Z roll. Slot 3 is the bone Y
+    /// Euler angle applied *last* under `EulerRot::ZYX`, matching how the wheel
+    /// spins about its own axle; slot 4 is a pure yaw. This pins the indices so
+    /// a slot renumbering elsewhere cannot silently retarget the animation.
+    #[test]
+    fn pose_slots_match_the_animation_targets() {
+        let root = part("vehicle", 1, vec![part("wheel_front", 1, vec![])]);
+        let mut poses = horizon_client::mobs::anim::Poses::new(&root);
+        poses.get("wheel_front")[3] = 1.5;
+        poses.get("wheel_front")[4] = -0.45;
+        assert_eq!(poses.pose(&part("wheel_front", 1, vec![]))[3], 1.5);
+        assert_eq!(poses.pose(&part("wheel_front", 1, vec![]))[4], -0.45);
+        // A name that is not in the tree edits only the dummy pose: the tree
+        // pose is untouched, so a stale reference animates nothing.
+        poses.get("wheel_rear")[3] = 1.0;
+        assert_ne!(poses.pose(&part("wheel_front", 1, vec![]))[3], 1.0);
+    }
+
+    /// `mod_travel` grows along the nose; the renderer maps it to a signed,
+    /// non-wrapped roll where a positive distance and a full turn agree. A
+    /// reversed travel must give the opposite rotation, not the same wrapped
+    /// value: braking in reverse has to spin the wheels backwards.
+    #[test]
+    fn wheel_roll_tracks_signed_travel() {
+        let radius = 0.35f64;
+        let angle = |travel| wheel_roll(travel, radius);
+        assert!((angle(radius * std::f64::consts::TAU) - angle(0.0)).abs() < 1e-4);
+        // The top of a wheel turns in opposite directions for a quarter-turn
+        // forward and back; half-turns instead have the same orientation.
+        let quarter = radius * std::f64::consts::FRAC_PI_2;
+        assert!((angle(quarter).sin() - 1.).abs() < 1e-5);
+        assert!((angle(-quarter).sin() + 1.).abs() < 1e-5);
+        assert!((angle(2. * quarter).cos() + 1.).abs() < 1e-5);
+        assert!((angle(-2. * quarter).cos() + 1.).abs() < 1e-5);
+    }
+}
