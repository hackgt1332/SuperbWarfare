+/// Capability `net` (experimental): a connection-scoped channel between the
+/// client and server components with the SAME mod id. Never an internet socket.
+interface net {
+    /// Opaque host-generated connection token, not a player identity or permission.
+    record session { high: u64, low: u64 }
+    record message {
+        /// On the server, the authenticated sender's UUID. On the client, none.
+        player: option<string>,
+        /// Server only: host token captured at enqueue time. Compare with
+        /// session-token if retaining a message across ticks/reconnections.
+        session: option<session>,
+        data: list<u8>,
+    }
+    variant event {
+        received(message),
+        /// Client connection ended or changed. Discard old session/prediction.
+        disconnected,
+    }
+    /// Client: the server announced channel support. Server: false (use the
+    /// online players instead). No channel is available on a vanilla server.
+    connected: func() -> bool;
+    /// Server only: fresh token for this player's current authenticated
+    /// connection, available after its first received message. None elsewhere.
+    session-token: func(player: string) -> option<session>;
+    /// Client: player must be none, sends to its server. Server: player must
+    /// name an online player's UUID. Host supplies the sending mod id and
+    /// authenticates players; bytes never select their sender. At most 16 KiB
+    /// per message and 8 messages per hook. An error queues nothing.
+    send: func(player: option<string>, data: list<u8>) -> result<_, string>;
+    /// Events in arrival order. Bounded to 64 events / 256 KiB; no polling
+    /// does not grant unbounded memory. Disconnect clears old queued messages.
+    poll: func() -> list<event>;
+}
