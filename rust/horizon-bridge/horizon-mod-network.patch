index 000000000..3f3bf9aea
--- /dev/null
+++ b/crates/horizon-mods/src/runtime/gameplay.rs
@@ -0,0 +1,90 @@
+//! Deferred, bounded server gameplay writes. The game revalidates every
+//! precondition against its live inventory before applying an edit.
+use super::{Output, State, play_api, render};
+impl play_api::Host for State {
+    fn inventories(&mut self) -> Vec<play_api::PlayerInventory> {
+        self.snapshot
+            .inventories
+            .iter()
+            .filter(|(id, _)| id == &self.id)
+            .map(|(_, p)| play_api::PlayerInventory {
+                player: p.player.clone(),
+                stacks: p
+                    .stacks
+                    .iter()
+                    .map(|s| play_api::Stack {
+                        slot: s.slot,
+                        item: s.item.clone(),
+                        count: s.count,
+                        selected: s.selected,
+                        state: s.state.clone(),
+                    })
+                    .collect(),
+            })
+            .collect()
+    }
+    fn vehicles(&mut self) -> Vec<play_api::Vehicle> {
+        self.snapshot
+            .vehicles
+            .iter()
+            .filter(|(id, _)| id == &self.id)
+            .map(|(_, v)| v.clone())
+            .collect()
+    }
+    fn commit(&mut self, edit: play_api::Edit) -> Result<(), String> {
+        let owned = |id: &str| id.starts_with(&format!("{}:", self.id));
+        if self
+            .out
+            .iter()
+            .filter(|o| matches!(o, Output::Gameplay { .. }))
+            .count()
+            >= 16
+        {
+            return Err("at most 16 gameplay edits per hook".into());
+        }
+        if edit.slot > 8
+            || !owned(&edit.item)
+            || edit.expected.len() > 4096
+            || edit.state.len() > 4096
+            || edit.consume > 4096
+            || (edit.consume > 0 && !owned(&edit.ammo))
+            || edit.vehicle.as_ref().is_some_and(|v| v.len() > 16384)
+            || edit.shot.as_ref().is_some_and(|p| {
+                !p.speed.is_finite()
+                    || !(0.1..=32.).contains(&p.speed)
+                    || !p.damage.is_finite()
+                    || !(0. ..=1000.).contains(&p.damage)
+                    || !p.inaccuracy.is_finite()
+                    || !(0. ..=30.).contains(&p.inaccuracy)
+            })
+        {
+            return Err("invalid gameplay edit".into());
+        }
+        if !self
+            .snapshot
+            .players
+            .iter()
+            .any(|p| p.id == edit.player && p.health > 0.)
+        {
+            return Err("player is not alive and online".into());
+        }
+        self.out.push(Output::Gameplay {
+            mod_id: self.id.clone(),
+            edit,
+        });
+        Ok(())
+    }
+}
+impl State {
+    pub(super) fn vehicle_models(&mut self, models: Vec<render::VehicleModel>) {
+        self.out.push(Output::VehicleModels {
+            mod_id: self.id.clone(),
+            models: models
+                .into_iter()
+                .take(64)
+                .filter(|v| v.profile.len() <= 16384)
+                .map(|v| (v.entity, v.profile))
+                .collect(),
+        });
+    }
+}
diff --git a/crates/horizon-mods/src/runtime/network.rs b/crates/horizon-mods/src/runtime/network.rs
new file mode 100644
index 000000000..7cc25fd3a
--- /dev/null
+++ b/crates/horizon-mods/src/runtime/network.rs
@@ -0,0 +1,275 @@
+//! Capability `net`: bounded inboxes and queued outputs; never reentrant guest calls.
+use super::{Mods, NetworkEvent, NetworkMessage, Output, Side, State, net};
+use std::collections::{HashMap, VecDeque};
+
+pub const MAX_DATA: usize = 16 * 1024;
+const MAX_EVENTS: usize = 64;
+const MAX_BYTES: usize = 256 * 1024;
+const PER_CALL: usize = 8;
+
+pub(super) struct NetworkState {
+    server: bool,
+    events: VecDeque<NetworkEvent>,
+    bytes: usize,
+    pub(super) sent: usize,
+    tokens: HashMap<String, (u64, net::Session)>,
+}
+impl NetworkState {
+    pub(super) fn new(server: bool) -> Self {
+        Self {
+            server,
+            events: VecDeque::new(),
+            bytes: 0,
+            sent: 0,
+            tokens: HashMap::new(),
+        }
+    }
+    fn push(&mut self, mut message: NetworkMessage, connection: u64) -> bool {
+        if message.data.len() > MAX_DATA {
+            return false;
+        }
+        if self.server
+            && let Some(player) = message.player.as_deref()
+        {
+            if self
+                .tokens
+                .get(player)
+                .is_some_and(|(old, _)| *old != connection)
+            {
+                self.remove_player(player);
+            }
+            if !self.tokens.contains_key(player) {
+                if self.tokens.len() >= 1024 {
+                    return false;
+                }
+                let mut bytes = [0; 16];
+                if getrandom::getrandom(&mut bytes).is_err() || bytes == [0; 16] {
+                    return false;
+                }
+                let token = net::Session {
+                    high: u64::from_le_bytes(bytes[..8].try_into().expect("eight bytes")),
+                    low: u64::from_le_bytes(bytes[8..].try_into().expect("eight bytes")),
+                };
+                self.tokens.insert(player.to_owned(), (connection, token));
+            }
+            message.session = self.tokens.get(player).map(|(_, token)| *token);
+        }
+        if message.data.len() > MAX_DATA
+            || self.events.len() >= MAX_EVENTS
+            || self.bytes + message.data.len() > MAX_BYTES
+        {
+            return false;
+        }
+        self.bytes += message.data.len();
+        self.events.push_back(NetworkEvent::Received(message));
+        true
+    }
+    fn disconnect(&mut self) {
+        self.events.clear();
+        self.bytes = 0;
+        self.events.push_back(NetworkEvent::Disconnected);
+    }
+    fn remove_player(&mut self, player: &str) {
+        self.tokens.remove(player);
+        self.events.retain(|event| {
+            !matches!(event,
+            NetworkEvent::Received(message) if message.player.as_deref() == Some(player))
+        });
+        self.bytes = self
+            .events
+            .iter()
+            .map(|event| match event {
+                NetworkEvent::Received(message) => message.data.len(),
+                _ => 0,
+            })
+            .sum();
+    }
+}
+
+impl Mods {
+    /// Caller supplies the sender from its authenticated connection. None means
+    /// a server-to-client delivery. Unknown ids, wrong sides and full inboxes fail.
+    /// This enqueues only; the recipient sees it on its next poll.
+    pub fn receive_network(&mut self, mod_id: &str, player: Option<&str>, data: &[u8]) -> bool {
+        self.receive_network_on(mod_id, player, data, 0)
+    }
+    /// Network hosts pass the actual connection generation so an immediate
+    /// reconnect with the same player UUID still gets a fresh session token.
+    pub fn receive_network_from(
+        &mut self,
+        mod_id: &str,
+        player: &str,
+        data: &[u8],
+        connection: u64,
+    ) -> bool {
+        self.receive_network_on(mod_id, Some(player), data, connection)
+    }
+    fn receive_network_on(
+        &mut self,
+        mod_id: &str,
+        player: Option<&str>,
+        data: &[u8],
+        connection: u64,
+    ) -> bool {
+        if data.len() > MAX_DATA {
+            return false;
+        }
+        let server = player.is_some();
+        let Some(entry) = self.entries.iter_mut().find(|e| {
+            e.run.is_some()
+                && e.manifest.as_ref().is_some_and(|m| {
+                    m.id == mod_id
+                        && (m.side == Side::Server) == server
+                        && m.capabilities.contains(&crate::Capability::Net)
+                })
+        }) else {
+            return false;
+        };
+        entry
+            .run
+            .as_mut()
+            .expect("running entry")
+            .store
+            .data_mut()
+            .network
+            .push(
+                NetworkMessage {
+                    player: player.map(str::to_owned),
+                    session: None,
+                    data: data.to_vec(),
+                },
+                connection,
+            )
+    }
+    /// Called on close AND before replacing a connection: old traffic never
+    /// crosses into another server. Keep a notification even while no tick runs.
+    pub fn network_disconnected(&mut self) {
+        self.out
+            .retain(|o| !matches!(o, Output::Network { player: None, .. }));
+        for run in self.entries.iter_mut().filter_map(|e| e.run.as_mut()) {
+            let state = run.store.data_mut();
+            if !state.network.server {
+                state.network.disconnect();
+                state.out.retain(|o| !matches!(o, Output::Network { .. }));
+            }
+        }
+        std::sync::Arc::make_mut(&mut self.snapshot).network_connected = false;
+    }
+    pub(super) fn network_player_left(&mut self, player: &str) {
+        self.out
+            .retain(|o| !matches!(o, Output::Network { player: Some(p), .. } if p == player));
+        for run in self.entries.iter_mut().filter_map(|e| e.run.as_mut()) {
+            let state = run.store.data_mut();
+            state.network.remove_player(player);
+            state
+                .out
+                .retain(|o| !matches!(o, Output::Network { player: Some(p), .. } if p == player));
+        }
+    }
+    /// Drop traffic/token only for the departed connection, not a newer one
+    /// which already reconnected using that player's UUID.
+    pub fn network_peer_left(&mut self, player: &str, connection: u64) {
+        for run in self.entries.iter_mut().filter_map(|e| e.run.as_mut()) {
+            let state = run.store.data_mut();
+            if state
+                .network
+                .tokens
+                .get(player)
+                .is_some_and(|(key, _)| *key == connection)
+            {
+                state.network.remove_player(player);
+                state.out.retain(
+                    |o| !matches!(o, Output::Network { player: Some(p), .. } if p == player),
+                );
+            }
+        }
+        self.out.retain(|o| !matches!(o, Output::Network { player: Some(p), connection: Some(key), .. } if p == player && *key == connection));
+    }
+}
+
+impl net::Host for State {
+    fn session_token(&mut self, player: String) -> Option<net::Session> {
+        self.network.tokens.get(&player).map(|(_, token)| *token)
+    }
+    fn connected(&mut self) -> bool {
+        !self.network.server && self.snapshot.network_connected
+    }
+    fn send(&mut self, player: Option<String>, data: Vec<u8>) -> Result<(), String> {
+        if data.len() > MAX_DATA || self.network.sent >= PER_CALL {
+            return Err("net: message or per-hook limit exceeded".into());
+        }
+        match (&player, self.network.server) {
+            (None, false) if self.snapshot.network_connected => {}
+            (Some(id), true)
+                if self.snapshot.players.iter().any(|p| &p.id == id)
+                    && self.network.tokens.contains_key(id) => {}
+            _ => return Err("net: disconnected, wrong destination side or player offline".into()),
+        }
+        self.network.sent += 1;
+        self.out.push(Output::Network {
+            mod_id: self.id.clone(),
+            connection: player
+                .as_ref()
+                .and_then(|id| self.network.tokens.get(id).map(|(key, _)| *key)),
+            player,
+            data,
+        });
+        Ok(())
+    }
+    fn poll(&mut self) -> Vec<NetworkEvent> {
+        self.network.bytes = 0;
+        self.network.events.drain(..).collect()
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    fn message(player: &str, len: usize) -> NetworkMessage {
+        NetworkMessage {
+            player: Some(player.into()),
+            session: None,
+            data: vec![0; len],
+        }
+    }
+    #[test]
+    fn queues_are_bounded_by_events_and_bytes_without_losing_old_messages() {
+        let mut queue = NetworkState::new(true);
+        for _ in 0..MAX_EVENTS {
+            assert!(queue.push(message("a", 0), 0));
+        }
+        assert!(!queue.push(message("b", 0), 0));
+        let mut queue = NetworkState::new(true);
+        for _ in 0..MAX_BYTES / MAX_DATA {
+            assert!(queue.push(message("a", MAX_DATA), 0));
+        }
+        assert!(!queue.push(message("b", 1), 0));
+        assert!(!queue.push(message("b", MAX_DATA + 1), 0));
+    }
+    #[test]
+    fn disconnect_and_departure_clear_stale_traffic() {
+        let mut queue = NetworkState::new(true);
+        assert!(queue.push(message("a", 10), 0));
+        assert!(queue.push(message("b", 20), 0));
+        queue.remove_player("a");
+        assert_eq!(queue.bytes, 20);
+        queue.disconnect();
+        assert_eq!(queue.bytes, 0);
+        assert!(matches!(
+            queue.events.front(),
+            Some(NetworkEvent::Disconnected)
+        ));
+        assert_eq!(queue.events.len(), 1);
+    }
+    #[test]
+    fn connection_generation_rotates_tokens_for_the_same_player() {
+        let mut queue = NetworkState::new(true);
+        assert!(queue.push(message("a", 1), 1));
+        let old = queue.tokens["a"].1;
+        assert!(queue.push(message("a", 1), 2));
+        let new = queue.tokens["a"].1;
+        assert!(old.high != new.high || old.low != new.low);
+        assert_eq!(queue.tokens["a"].0, 2);
+        assert_eq!(queue.events.len(), 1);
+    }
+}
