+        assert!(VehicleProfile::parse(&serde_json::to_string(&p).unwrap(), "other").is_none());
+        p.max_speed = 100.;
+        assert!(VehicleProfile::parse(&serde_json::to_string(&p).unwrap(), "test").is_none());
+        p = profile();
+        p.boxes[0].max[0] = -2.;
+        assert!(VehicleProfile::parse(&serde_json::to_string(&p).unwrap(), "test").is_none());
+        assert!(VehicleProfile::parse(r#"{"max_speed":1e999}"#, "test").is_none());
+    }
