+        assert!(parse(br#"{"texture":"demo:../car","model":{}}"#, "demo").is_none());
+        assert!(
+            parse(
+                br#"{"texture":"demo:car","model":{"pose":[0,0,0,0,0,0,0,1,1]}}"#,
+                "demo"
+            )
+            .is_none()
+        );
+    }
+    /// A texture must stay inside the namespace of the document that names it.
+    #[test]
