+//! Generic mod gameplay adapter. All mutations execute on the authoritative
+//! game thread, against the selected stack, with no client supplied aim/pose.
+#[cfg(feature = "mods")]
+use super::{Game, boats::Boat, lan::LanHost};
+#[cfg(feature = "mods")]
+use horizon_client::{
+    items::ItemStack,
+    mod_vehicle::{self, ModVehicle, VehicleProfile},
+};
+#[cfg(feature = "mods")]
+use horizon_core::geometry::Vec3;
+#[cfg(feature = "mods")]
+struct VehicleGround<'w, 'r> {
+    scene: horizon_client::collisions::SceneCollisions<'w, 'r>,
+}
+#[cfg(feature = "mods")]
+impl mod_vehicle::GroundPlacementWorld for VehicleGround<'_, '_> {
+    fn support_height(&mut self, x: f64, z: f64, ceiling: f64, floor: f64) -> Option<f64> {
+        use horizon_core::geometry::Aabb;
+        if !self.scene.world.loaded(x.floor() as i32, z.floor() as i32) {
+            return None;
+        }
+        let probe = Aabb::new(
+            Vec3::new(x - 0.04, ceiling, z - 0.04),
+            Vec3::new(x + 0.04, ceiling + 0.08, z + 0.04),
+        );
+        if !self.scene.unobstructed(probe).ok()? {
+            return None;
+        }
+        let wanted = floor - ceiling;
+        let moved = self
+            .scene
+            .resolve(probe, Vec3::new(0., wanted, 0.), 0., false)
+            .ok()?;
+        (moved.y > wanted + 1e-6).then_some(ceiling + moved.y)
+    }
+    fn unobstructed(&mut self, bounds: horizon_core::geometry::Aabb) -> bool {
+        let min = bounds.min_position();
+        let max = bounds.max_position();
+        for x in (min.x.floor() as i32 >> 4)..=((max.x - 1e-5).floor() as i32 >> 4) {
+            for z in (min.z.floor() as i32 >> 4)..=((max.z - 1e-5).floor() as i32 >> 4) {
+                if !self.scene.world.chunks.contains_key(&(x, z)) {
+                    return false;
+                }
+            }
+        }
+        self.scene
+            .unobstructed(bounds.deflate(Vec3::new(1e-5, 1e-5, 1e-5)))
+            .unwrap_or(false)
+    }
+}
+#[cfg(feature = "mods")]
+impl Game<'_> {
+    pub(super) fn mod_inventories(&self) -> Vec<(String, horizon_mods::PlayerInventory)> {
+        let mut result = Vec::new();
+        for owner in self.mods.mods.gameplay_ids() {
+            let stacks = |items: &[Option<ItemStack>], selected: usize| {
+                items
+                    .iter()
+                    .enumerate()
+                    .filter_map(|(slot, s)| {
+                        s.as_ref().map(|s| horizon_mods::InventoryStack {
+                            slot: slot as u32,
+                            item: s.item.to_string(),
+                            count: s.count,
+                            selected: slot == selected,
+                            state: mod_vehicle::item_state(s, &owner),
+                        })
+                    })
+                    .collect()
+            };
+            if self.remote.is_none()
+                && self.options.execution_role.is_client()
+                && self.player.is_some()
+            {
+                result.push((
+                    owner.clone(),
+                    horizon_mods::PlayerInventory {
+                        player: self.player_uuid_string(),
+                        stacks: stacks(&self.inventory, self.selected),
+                    },
+                ));
+            }
+            if let Some(host) = &self.lan {
+                for g in host.hub.guests.iter().filter(|g| g.placed) {
+                    result.push((
+                        owner.clone(),
+                        horizon_mods::PlayerInventory {
+                            player: super::mod_network::uuid_string(g.uuid),
+                            stacks: stacks(&g.inventory, g.selected),
+                        },
+                    ));
+                }
+            }
+        }
+        result
+    }
+    pub(super) fn mod_vehicles(&self) -> Vec<(String, horizon_mods::ModVehicle)> {
+        self.boats
+            .iter()
+            .map(|boat| (self.dim, boat))
+            .chain(
+                self.levels
+                    .parked_boats()
+                    .filter(|(dim, _)| *dim != self.dim),
+            )
+            .filter_map(|(dim, b)| {
+                let v = b.mod_vehicle.as_ref()?;
+                Some((
+                    v.owner.clone(),
+                    horizon_mods::ModVehicle {
+                        entity: b.id,
+                        definition: v.profile.definition.clone(),
+                        dimension: dim.id().into(),
+                        profile: serde_json::to_string(&v.profile).ok()?,
+                        x: b.position.x,
+                        y: b.position.y,
+                        z: b.position.z,
+                        yaw: b.yaw,
+                        vx: b.velocity.x,
+                        vy: b.velocity.y,
+                        vz: b.velocity.z,
+                    },
+                ))
+            })
+            .collect()
+    }
+    pub(super) fn apply_mod_inventory(
+        &mut self,
+        host: Option<&mut LanHost>,
+        owner: &str,
+        edit: horizon_mods::InventoryEdit,
+    ) {
+        if self.remote.is_some() {
+            return;
+        }
+        if self.options.execution_role.is_client()
+            && self.player.is_some()
+            && self.player_uuid_string() == edit.player
+        {
+            self.commit_mod_inventory(owner, edit);
+            return;
+        }
+        let own_host = host.is_none();
+        let mut taken = if own_host { self.lan.take() } else { None };
+        if let Some(host) = host.or(taken.as_mut()) {
+            let target = host
+                .hub
+                .guests
+                .iter()
+                .find(|g| {
+                    g.placed
+                        && g.loaded
+                        && !g.dead
+                        && super::mod_network::uuid_string(g.uuid) == edit.player
+                })
+                .map(|g| (g.conn, super::Dim::from_id(&g.dimension)));
+            if let Some((conn, theirs)) = target
+                && !self.on_server_trip(conn)
+            {
+                // as_guest lends only the player's state. The world and
+                // entities must first be those of that player's dimension.
+                let back = self.dim;
+                let entered = if theirs == back {
+                    true
+                } else {
+                    match self.enter_level(Some(host), theirs) {
+                        Ok(()) => self.dim == theirs,
+                        Err(error) => {
+                            log::error!("could not open {} for mod gameplay: {error}", theirs.id());
+                            false
+                        }
+                    }
+                };
+                if entered {
+                    self.as_guest(host, conn, |game| game.commit_mod_inventory(owner, edit));
+                }
+                if self.dim != back
+                    && let Err(error) = self.enter_level(Some(host), back)
+                {
+                    log::error!("could not reopen {} after mod gameplay: {error}", back.id());
+                }
+            }
+        }
+        if own_host {
+            self.lan = taken;
+        }
+    }
+    fn commit_mod_inventory(&mut self, owner: &str, edit: horizon_mods::InventoryEdit) {
+        if self.selected != edit.slot as usize
+            || self.spectator()
+            || self.player.as_ref().is_none_or(|p| p.health.health() <= 0.)
+        {
+            return;
+        }
+        let Some(held) = self.held() else {
+            return;
+        };
+        if held.item.as_ref() != edit.item
+            || held.count != 1
+            || mod_vehicle::item_state(held, owner) != edit.expected
+        {
+            return;
+        }
+        let available: u32 = self
+            .inventory
+            .iter()
+            .flatten()
+            .filter(|s| s.item.as_ref() == edit.ammo)
+            .map(|s| s.count)
+            .sum();
+        if (edit.consume > 0 && edit.ammo == edit.item) || available < edit.consume {
+            return;
+        }
+        let Some(eye) = self.eye_position() else {
+            return;
+        };
+        let spawn = if let Some(json) = &edit.vehicle {
+            let Some(profile) = VehicleProfile::parse(json, owner).filter(|p| p.item == edit.item)
+            else {
+                log::debug!("mod vehicle placement: invalid profile for {}", edit.item);
+                return;
+            };
+            // Ground deployment clips actual collision surfaces: grass and
+            // other empty outlines cannot move the chassis into mid-air.
+            let mut ground = VehicleGround {
+                scene: horizon_client::collisions::SceneCollisions {
+                    world: &self.world,
+                    binding: self.collision,
+                    subject: None,
+                },
+            };
+            let Some(hit) = self.vehicle_ground_hit(&mut ground.scene) else {
+                log::debug!("mod vehicle placement: no upward ground hit");
+                return;
+            };
+            // The clicked surface anchors the back of the chassis, so a long
+            // vehicle does not spawn around the player standing behind it.
+            let (sin, cos) = f64::from(self.yaw).to_radians().sin_cos();
+            let offset = profile.length * 0.5 + 0.4;
+            let center = hit.add_vector(Vec3::new(-sin * offset, 0., cos * offset));
+            let Some(at) =
+                mod_vehicle::ground_placement(&profile, center, [0, 1, 0], self.yaw, &mut ground)
+            else {
+                log::debug!(
+                    "mod vehicle placement: unsupported or obstructed footprint at {center:?}"
+                );
+                return;
+            };
+            let mut b = Boat::new(self.next_entity + 1, "oak".into(), at, self.yaw);
+            b.mod_vehicle = Some(ModVehicle {
+                owner: owner.into(),
+                health: profile.max_health,
+                profile,
+            });
+            if self.boat_entity_collision(b.bounds()) {
+                log::debug!("mod vehicle placement: entity obstructs the footprint");
+                return;
+            }
+            Some(b)
+        } else {
+            None
+        };
+        if !mod_vehicle::apply_inventory_edit(&mut self.inventory, self.selected, owner, &edit) {
+            return;
+        }
+        if let Some(b) = spawn {
+            self.next_entity += 1;
+            self.world.modified.insert((
+                b.position.x.floor() as i32 >> 4,
+                b.position.z.floor() as i32 >> 4,
+            ));
+            self.boats.push(b);
+        }
+        if let Some(spec) = edit.shot {
+            use horizon_client::{
+                mobs::Who as Owner,
+                projectiles::{Projectile, ProjectileKind},
+            };
+            let kind = ProjectileKind::Arrow {
+                base_damage: f64::from(spec.damage / spec.speed),
+                critical: false,
+                effect: None,
+            };
+            let mut p = Projectile::new(
+                kind,
+                Vec3::new(eye[0], eye[1] - 0.1, eye[2]),
+                Some(Owner::Player),
+            );
+            if let Some(a) = p.arrow.as_mut() {
+                a.set_owner(Some(Owner::Player));
+                a.set_item(&horizon_client::arrows::drawn_ammo(
+                    &ItemStack::new("minecraft:arrow", 1),
+                    true,
+                ));
+            }
+            p.shoot_from_rotation(
+                &mut self.world.random,
+                self.pitch,
+                self.yaw,
+                0.,
+                spec.speed,
+                spec.inaccuracy,
+                Vec3::ZERO,
+                true,
+            );
+            self.add_projectile(p);
+            self.player_projectile_shot();
+            self.audio.play(
+                "minecraft:entity.firework_rocket.blast",
+                Some(eye),
+                0.7,
+                1.6,
+            );
+        }
+    }
+    /// Server-owned eye/yaw, with collision shapes and an upward surface.
+    /// Deliberately bypasses forced_hit from unrelated vanilla use packets.
+    fn vehicle_ground_hit(
+        &self,
+        scene: &mut horizon_client::collisions::SceneCollisions<'_, '_>,
+    ) -> Option<Vec3> {
+        use horizon_core::geometry::{Direction, traverse_blocks};
+        use horizon_world::collision_context::CollisionContext;
+        let eye = self.eye_position()?;
+        let start = Vec3::new(eye[0], eye[1], eye[2]);
+        let dir = super::view_vector(self.yaw, self.pitch);
+        let end = start.add_vector(Vec3::new(dir[0], dir[1], dir[2]).scale(self.reach()));
+        let context = CollisionContext::position(start.y);
+        let binding = self.collision;
+        let hit = traverse_blocks(start, end, 128, |p| {
+            if !scene.world.loaded(p.x, p.z) {
+                return Some(Err(()));
+            }
+            let state = scene.world.block(p.x, p.y, p.z);
+            match binding.collision_shape_with_context(scene, state, p, &context) {
+                Ok(shape) => shape.clip(start, end, p).map(Ok),
+                Err(_) => Some(Err(())),
+            }
+        })
+        .ok()??
+        .ok()?;
+        (hit.direction == Direction::Up && !hit.inside).then_some(hit.location)
+    }
+    pub(super) fn apply_vehicle_models(&mut self, owner: &str, models: Vec<(u32, String)>) {
+        if self.remote.is_none() {
+            return;
+        } // A client never overrides authoritative profiles.
+        for b in &mut self.boats {
+            if let Some((_, json)) = models.iter().find(|(id, _)| *id == b.id) {
+                if let Some(profile) = VehicleProfile::parse(json, owner) {
+                    b.mod_vehicle = Some(ModVehicle {
+                        owner: owner.into(),
+                        health: profile.max_health,
+                        profile,
+                    });
+                }
+            } else if b.mod_vehicle.as_ref().is_some_and(|v| v.owner == owner) {
+                b.mod_vehicle = None;
+            }
+        }
+    }
+}
