+/// Chassis collision uses a conservative world-axis box around the rotated
+/// footprint; rendering and seating retain the exact local orientation.
+pub fn chassis_bounds(
+    profile: &VehicleProfile,
+    at: horizon_core::geometry::Vec3,
+    yaw: f32,
+) -> horizon_core::geometry::Aabb {
+    use horizon_core::geometry::{Aabb, Vec3};
+    let (sin, cos) = f64::from(yaw).to_radians().sin_cos();
+    let half_x = (profile.width * cos.abs() + profile.length * sin.abs()) * 0.5;
+    let half_z = (profile.length * cos.abs() + profile.width * sin.abs()) * 0.5;
+    Aabb::new(
+        Vec3::new(at.x - half_x, at.y, at.z - half_z),
+        Vec3::new(at.x + half_x, at.y + profile.height, at.z + half_z),
+    )
+}
+
+/// Collision probes needed to place a ground chassis. Implementations must
+/// reject unloaded cells and query real collision surfaces, not outline boxes.
+pub trait GroundPlacementWorld {
+    fn support_height(&mut self, x: f64, z: f64, ceiling: f64, floor: f64) -> Option<f64>;
+    fn unobstructed(&mut self, bounds: horizon_core::geometry::Aabb) -> bool;
+}
+/// Settle all corners on a supported surface. A chassis cannot be deployed
+/// against a wall/ceiling, over a ledge, or across a step taller than it can climb.
+pub fn ground_placement(
+    profile: &VehicleProfile,
+    hit: horizon_core::geometry::Vec3,
+    normal: [i32; 3],
+    yaw: f32,
+    world: &mut impl GroundPlacementWorld,
+) -> Option<horizon_core::geometry::Vec3> {
+    use horizon_core::geometry::Vec3;
+    if normal != [0, 1, 0]
+        || ![hit.x, hit.y, hit.z, f64::from(yaw)]
+            .iter()
+            .all(|n| n.is_finite())
+    {
+        return None;
+    }
+    let (sin, cos) = f64::from(yaw).to_radians().sin_cos();
+    // Keep probes just inside the wheels/footprint so a legal block edge does
+    // not fail because of floating point contact with the neighbouring cell.
+    let x = (profile.width * 0.5 - 0.08).max(0.1);
+    let z = (profile.length * 0.5 - 0.08).max(0.1);
+    let mut bottom = f64::NEG_INFINITY;
+    let mut lowest = f64::INFINITY;
+    // Sample the wheel lines and centre at half-block intervals so a long
+    // chassis cannot bridge an unsupported cell between its corners.
+    let rows = (z * 4.).ceil().max(1.) as usize;
+    let samples = (0..=rows).flat_map(|row| {
+        let local_z = -z + 2. * z * row as f64 / rows as f64;
+        [-x, 0., x]
+            .into_iter()
+            .map(move |local_x| (local_x, local_z))
+    });
+    for (local_x, local_z) in samples {
+        let px = hit.x + local_x * cos - local_z * sin;
+        let pz = hit.z + local_x * sin + local_z * cos;
+        let h = world.support_height(px, pz, hit.y + 0.65, hit.y - 1.0)?;
+        if !h.is_finite() {
+            return None;
+        }
+        bottom = bottom.max(h);
+        lowest = lowest.min(h);
+    }
+    if bottom - lowest > 0.6 + 1e-6 {
+        return None;
+    }
+    let at = Vec3::new(hit.x, bottom + 0.002, hit.z);
+    world
+        .unobstructed(chassis_bounds(profile, at, yaw))
+        .then_some(at)
+}
+
+#[derive(Clone, Copy, Debug)]
+pub struct DriveMotion {
+    pub velocity: horizon_core::geometry::Vec3,
+    pub yaw: f32,
+    pub turn: f32,
+}
+/// Signed longitudinal motion with tyre grip. Opposite throttle brakes before
+/// reverse engages; reverse turns the chassis the opposite way. All values are
+/// in blocks/tick and degrees/tick, independent of rendered frame rate.
+pub fn ground_drive(
+    profile: &VehicleProfile,
+    velocity: horizon_core::geometry::Vec3,
+    yaw: f32,
+    input: [bool; 4],
+    grounded: bool,
+) -> DriveMotion {
+    use horizon_core::geometry::Vec3;
+    let [left, right, forward, back] = input;
+    let (sin, cos) = f64::from(yaw).to_radians().sin_cos();
+    let mut longitudinal = -sin * velocity.x + cos * velocity.z;
+    let mut lateral = cos * velocity.x + sin * velocity.z;
+    let throttle = f64::from(i32::from(forward) - i32::from(back));
+    longitudinal *= profile.drag;
+    lateral *= if grounded { 0.25 } else { 0.98 };
+    if grounded {
+        let brake = forward && back || throttle != 0. && longitudinal * throttle < -0.002;
+        if brake {
+            let amount = profile.acceleration * 3.;
+            longitudinal = longitudinal.signum() * (longitudinal.abs() - amount).max(0.);
+        } else {
+            longitudinal += throttle * profile.acceleration;
+        }
+    }
+    longitudinal = longitudinal.clamp(-profile.max_speed * 0.45, profile.max_speed);
+    if throttle == 0. && longitudinal.abs() < 0.001 {
+        longitudinal = 0.;
+    }
+    let steer = f64::from(i32::from(right) - i32::from(left));
+    let turn = if grounded && longitudinal.abs() > 0.002 {
+        (steer
+            * longitudinal.signum()
+            * f64::from(profile.turn_speed)
+            * (longitudinal.abs() / profile.max_speed)
+                .sqrt()
+                .clamp(0.2, 1.)) as f32
+    } else {
+        0.
+    };
+    let next_yaw = yaw + turn;
+    let (sin, cos) = f64::from(next_yaw).to_radians().sin_cos();
+    let mut next = Vec3::new(
+        -sin * longitudinal + cos * lateral,
+        velocity.y,
+        cos * longitudinal + sin * lateral,
+    );
+    let horizontal = (next.x * next.x + next.z * next.z).sqrt();
+    if horizontal > profile.max_speed {
+        next.x *= profile.max_speed / horizontal;
+        next.z *= profile.max_speed / horizontal;
+    }
+    DriveMotion {
+        velocity: next,
+        yaw: next_yaw,
+        turn,
+    }
+}
+
+/// Client-only prediction state. Server positions remain the authority; this
+/// merely eases small transport corrections and snaps genuine teleports.
+#[derive(Clone, Debug)]
+pub struct VehicleCorrection {
+    position: horizon_core::geometry::Vec3,
+    yaw: f32,
+    velocity: horizon_core::geometry::Vec3,
+    yaw_rate: f32,
+    received_tick: u64,
+    remaining: u8,
+}
+fn angle_delta(to: f32, from: f32) -> f32 {
+    (to - from + 180.).rem_euclid(360.) - 180.
+}
+impl VehicleCorrection {
+    /// Capture an authenticated server pose and a bounded motion estimate.
+    /// Invalid poses are ignored by callers before capture; large errors snap
+    /// in correct() instead of gliding through intervening obstacles.
+    pub fn receive(
+        previous: Option<&Self>,
+        position: horizon_core::geometry::Vec3,
+        yaw: f32,
+        tick: u64,
+        profile: &VehicleProfile,
+    ) -> Self {
+        use horizon_core::geometry::Vec3;
+        let (velocity, yaw_rate) = previous
+            .filter(|old| position.distance_squared(old.position) <= 64.)
+            .map_or((Vec3::ZERO, 0.), |old| {
+                let dt = tick.saturating_sub(old.received_tick).max(1) as f64;
+                let mut v = position.subtract(old.position).scale(1. / dt);
+                let horizontal = (v.x * v.x + v.z * v.z).sqrt();
+                if horizontal > profile.max_speed {
+                    v.x *= profile.max_speed / horizontal;
+                    v.z *= profile.max_speed / horizontal;
+                }
+                v.y = v.y.clamp(-3., 3.);
+                (
+                    v,
+                    (angle_delta(yaw, old.yaw) / dt as f32)
+                        .clamp(-profile.turn_speed, profile.turn_speed),
+                )
+            });
+        Self {
+            position,
+            yaw,
+            velocity,
+            yaw_rate,
+            received_tick: tick,
+            remaining: 3,
+        }
+    }
+    pub fn correct(
+        &mut self,
+        position: &mut horizon_core::geometry::Vec3,
+        yaw: &mut f32,
+        velocity: &mut horizon_core::geometry::Vec3,
+        tick: u64,
+    ) {
+        if self.remaining == 0 {
+            return;
+        }
+        if position.distance_squared(self.position) > 64. {
+            *position = self.position;
+            *yaw += angle_delta(self.yaw, *yaw);
+            *velocity = self.velocity;
+            self.remaining = 0;
+            return;
+        }
+        let age = tick.saturating_sub(self.received_tick).min(2) as f64 + 1.;
+        let target = self.position.add_vector(self.velocity.scale(age));
+        let gain = 1. / f64::from(self.remaining);
+        *position = position.add_vector(target.subtract(*position).scale(gain));
+        *yaw += angle_delta(self.yaw + self.yaw_rate * age as f32, *yaw) * gain as f32;
+        *velocity = velocity
+            .scale(1. - 0.25 * gain)
+            .add_vector(self.velocity.scale(0.25 * gain));
+        self.remaining -= 1;
+    }
+}
+
+#[cfg(test)]
+mod chassis_tests {
+    use super::*;
+    use horizon_core::geometry::{Aabb, Vec3};
+    fn profile() -> VehicleProfile {
+        serde_json::from_str(r#"{"definition":"test:car","item":"test:car","width":2,"length":3.2,"height":1.6,"seat_height":0.85,"acceleration":0.035,"drag":0.96,"max_speed":0.65,"turn_speed":3,"max_health":175,"boxes":[{"min":[-1,0,-1.6],"max":[1,1.6,1.6],"color":4294967295}]}"#).unwrap()
+    }
+    struct Ground {
+        kind: u8,
+        free: bool,
+    }
+    impl GroundPlacementWorld for Ground {
+        fn support_height(&mut self, x: f64, _z: f64, _ceiling: f64, _floor: f64) -> Option<f64> {
+            match self.kind {
+                1 if x > 0.5 => None,
+                2 => Some(if x > 0. { 0.5 } else { 0. }),
+                3 => Some(if x > 0. { 1. } else { 0. }),
+                _ => Some(0.),
+            }
+        }
+        fn unobstructed(&mut self, _: Aabb) -> bool {
+            self.free
+        }
+    }
+    #[test]
+    fn placement_rejects_walls_unsupported_edges_and_large_steps() {
+        let p = profile();
+        let at = Vec3::new(0., 0., 0.);
+        assert!(
+            ground_placement(
+                &p,
+                at,
+                [1, 0, 0],
+                0.,
+                &mut Ground {
+                    kind: 0,
+                    free: true
+                }
+            )
+            .is_none()
+        );
+        assert!(
+            ground_placement(
+                &p,
+                at,
+                [0, 1, 0],
+                0.,
+                &mut Ground {
+                    kind: 1,
+                    free: true
+                }
+            )
+            .is_none()
+        );
+        assert!(
+            ground_placement(
+                &p,
+                at,
+                [0, 1, 0],
+                0.,
+                &mut Ground {
+                    kind: 3,
+                    free: true
+                }
+            )
+            .is_none()
+        );
+        assert!(
+            ground_placement(
+                &p,
+                at,
+                [0, 1, 0],
+                0.,
+                &mut Ground {
+                    kind: 0,
+                    free: false
+                }
+            )
+            .is_none()
+        );
+        let settled = ground_placement(
+            &p,
+            at,
+            [0, 1, 0],
+            0.,
+            &mut Ground {
+                kind: 2,
+                free: true,
+            },
+        )
+        .unwrap();
+        assert!((settled.y - 0.502).abs() < 1e-9);
+    }
+    #[test]
+    fn steering_tracks_forward_and_reverses_while_backing() {
+        let p = profile();
+        let f = ground_drive(
+            &p,
+            Vec3::new(0., 0., 0.3),
+            0.,
+            [false, true, true, false],
+            true,
+        );
+        assert!(f.turn > 0. && f.velocity.x < 0.);
+        let r = ground_drive(
+            &p,
+            Vec3::new(0., 0., -0.2),
+            0.,
+            [false, true, false, true],
+            true,
+        );
+        assert!(r.turn < 0.);
+        let mut velocity = Vec3::new(0., 0., 0.3);
+        let mut previous = velocity.z;
+        for _ in 0..3 {
+            velocity = ground_drive(&p, velocity, 0., [false, false, false, true], true).velocity;
+            assert!(velocity.z >= 0. && velocity.z < previous);
+            previous = velocity.z;
+        }
+        let mut velocity = Vec3::ZERO;
+        for _ in 0..100 {
+            velocity = ground_drive(&p, velocity, 0., [false, false, false, true], true).velocity;
+        }
+        assert!(velocity.z < -0.1 && velocity.z >= -p.max_speed * 0.45 - 1e-9);
+        for _ in 0..100 {
+            velocity = ground_drive(&p, velocity, 0., [false, false, true, false], true).velocity;
+        }
+        assert!(velocity.z > 0.6 && velocity.z <= p.max_speed + 1e-9);
+    }
+    #[test]
+    fn prediction_corrections_are_smooth_wrap_yaw_and_snap_teleports() {
+        let p = profile();
+        let mut c = VehicleCorrection::receive(None, Vec3::ZERO, -179., 1, &p);
+        let (mut at, mut yaw, mut velocity) = (Vec3::new(0.9, 0., 0.), 179., Vec3::ZERO);
+        c.correct(&mut at, &mut yaw, &mut velocity, 1);
+        assert!(at.x > 0. && at.x < 0.9);
+        assert!((yaw - 179.).abs() < 2.);
+        c.correct(&mut at, &mut yaw, &mut velocity, 2);
+        c.correct(&mut at, &mut yaw, &mut velocity, 3);
+        assert_eq!(at, Vec3::ZERO);
+        assert!((angle_delta(yaw, -179.)).abs() < 1e-5);
+        let mut c = VehicleCorrection::receive(None, Vec3::new(20., 0., 0.), 0., 4, &p);
+        c.correct(&mut at, &mut yaw, &mut velocity, 4);
+        assert_eq!(at.x, 20.);
+    }
+    #[test]
+    fn long_chassis_requires_support_between_corners_and_after_rotation() {
+        struct Road {
+            hole: bool,
+        }
+        impl GroundPlacementWorld for Road {
+            fn support_height(&mut self, x: f64, z: f64, _: f64, _: f64) -> Option<f64> {
+                (x.abs() <= 1.5
+                    && z.abs() <= 6.
+                    && !(self.hole && x.abs() < 0.1 && z > 1. && z < 2.))
+                    .then_some(100.)
+            }
+            fn unobstructed(&mut self, _: Aabb) -> bool {
+                true
+            }
+        }
+        let mut p = profile();
+        p.width = 2.5;
+        p.length = 8.8;
+        let at = Vec3::new(0., 100., 0.);
+        assert!(ground_placement(&p, at, [0, 1, 0], 0., &mut Road { hole: false }).is_some());
+        assert!(ground_placement(&p, at, [0, 1, 0], 90., &mut Road { hole: false }).is_none());
+        assert!(ground_placement(&p, at, [0, 1, 0], 0., &mut Road { hole: true }).is_none());
+    }
+    #[test]
+    fn prediction_does_not_infer_speed_from_a_teleport_or_shortened_sample_gap() {
+        let p = profile();
+        let old = VehicleCorrection::receive(None, Vec3::ZERO, 0., 1, &p);
+        let mut c = VehicleCorrection::receive(Some(&old), Vec3::new(20., 0., 0.), 90., 2, &p);
+        let (mut at, mut yaw, mut velocity) = (Vec3::new(20., 0., 0.), 90., Vec3::ZERO);
+        for tick in 2..5 {
+            c.correct(&mut at, &mut yaw, &mut velocity, tick);
+        }
+        assert_eq!(at, Vec3::new(20., 0., 0.));
+        assert_eq!(yaw, 90.);
+        assert_eq!(velocity, Vec3::ZERO);
+
+        let mut c = VehicleCorrection::receive(Some(&old), Vec3::new(1., 0., 0.), 0., 21, &p);
+        let (mut at, mut yaw, mut velocity) = (Vec3::new(1., 0., 0.), 0., Vec3::ZERO);
+        c.correct(&mut at, &mut yaw, &mut velocity, 21);
+        assert!((at.x - (1. + 0.05 / 3.)).abs() < 1e-9);
+    }
+}
